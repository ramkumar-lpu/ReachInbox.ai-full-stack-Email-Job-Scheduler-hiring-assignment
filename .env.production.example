# =============================================================================
# Production Environment Variables Template (.env.production.example)
# Domain: scheduler.ramkumar.app
# Host: AWS EC2 (t3.small, Ubuntu x86, ap-south-1)
# =============================================================================
# Copy this file to .env on the EC2 production server:
#   cp .env.production.example .env
# Fill in real values for DATABASE_URL, JWT_SECRET, and OAuth credentials.
# NEVER commit the filled .env file or real secrets to Git.
# =============================================================================

# Node Environment & Server Port
NODE_ENV=production
PORT=4000

# -----------------------------------------------------------------------------
# Neon PostgreSQL Database Connection
# -----------------------------------------------------------------------------
# Replace with your actual Neon PostgreSQL connection string (with SSL mode required).
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123.ap-south-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-pool.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Docker Internal Service Connections
# (Private to the Docker Compose network; not exposed externally)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
ELASTICSEARCH_URL=http://elasticsearch:9200

# -----------------------------------------------------------------------------
# Application Origin & Security
# -----------------------------------------------------------------------------
FRONTEND_URL=https://scheduler.ramkumar.app

# JWT Secret: Generate a secure 32+ character hex string using:
#   openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# (Obtain from Google Cloud Console: APIs & Services > Credentials)
# Authorized JavaScript Origin: https://scheduler.ramkumar.app
# Authorized Redirect URI: https://scheduler.ramkumar.app/api/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://scheduler.ramkumar.app/api/auth/google/callback

# -----------------------------------------------------------------------------
# Slack OAuth 2.0 Credentials
# (Obtain from Slack API App Dashboard: OAuth & Permissions)
# Redirect URL: https://scheduler.ramkumar.app/api/slack/callback
# Bot Scopes: chat:write, channels:read
# -----------------------------------------------------------------------------
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_CALLBACK_URL=https://scheduler.ramkumar.app/api/slack/callback

# -----------------------------------------------------------------------------
# Background Worker Performance Tuning
# -----------------------------------------------------------------------------
# Number of concurrent jobs processed simultaneously by BullMQ worker
WORKER_CONCURRENCY=5

# Minimum artificial delay (in milliseconds) between sends to prevent burst spikes
MIN_SEND_DELAY_MS=200

# Disable embedded worker in API container (dedicated worker container is active)
EMBEDDED_WORKER=false
