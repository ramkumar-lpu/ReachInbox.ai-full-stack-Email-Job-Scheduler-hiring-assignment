# =============================================================================
# Production Environment Variables Template (.env.production.example)
# Domain: scheduler.ramkumar.app
# Host: AWS EC2 (t3.small, Ubuntu x86, ap-south-1)
# =============================================================================
# Instructions:
# 1. On your production EC2 server, copy this file to .env:
#      cp .env.production.example .env
# 2. Fill in real values for DATABASE_URL, JWT_SECRET, ADMIN_PASSWORD, and OAuth keys.
# 3. Protect file permissions:
#      chmod 600 .env
# 4. NEVER commit the filled .env file or real secrets to Git.
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=4000

# -----------------------------------------------------------------------------
# Neon PostgreSQL Database Connection
# -----------------------------------------------------------------------------
# Supply your managed Neon PostgreSQL connection string (must require SSL).
# The connection string is read directly by Prisma and never printed in logs.
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-pool.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Docker Internal Service Connections
# (Private to Docker internal network; never exposed on host interfaces)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Elasticsearch Configuration (Optional)
# -----------------------------------------------------------------------------
# Set to 'false' (default) to run lightweight on t3.small EC2 (saves ~600MB RAM).
# When disabled or unavailable, all searches seamlessly use PostgreSQL fallback.
# If set to 'true', launch docker compose with the search profile:
#   docker compose -f docker-compose.prod.yml --profile search up -d
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://elasticsearch:9200

# -----------------------------------------------------------------------------
# Application Public Origin & Security
# -----------------------------------------------------------------------------
FRONTEND_URL=https://scheduler.ramkumar.app

# JWT Secret: REQUIRED in production.
# Must be at least 32 characters long. Insecure default placeholders are rejected at boot.
# Generate a strong 64-character random hex key using:
#   openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret

# -----------------------------------------------------------------------------
# Bull Board Queue Dashboard Protection (/admin/queues)
# -----------------------------------------------------------------------------
# In production, the queue monitoring dashboard is protected by HTTP Basic Auth.
# If ADMIN_PASSWORD is missing or shorter than 8 characters, access fails closed (503).
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_admin_password_min_8_chars

# -----------------------------------------------------------------------------
# Authentication Guard Policies
# -----------------------------------------------------------------------------
# Strictly false in production. Ensures unauthenticated requests receive HTTP 401
# and prevents any automatic fallback to the development tenant user.
ALLOW_DEV_AUTH=false

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# (Obtain from Google Cloud Console: APIs & Services > Credentials)
# Authorized JavaScript Origin: https://scheduler.ramkumar.app
# Authorized Redirect URI: https://scheduler.ramkumar.app/api/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://scheduler.ramkumar.app/api/auth/google/callback

# -----------------------------------------------------------------------------
# Slack OAuth 2.0 Credentials
# (Obtain from Slack API App Dashboard: OAuth & Permissions)
# Redirect URL: https://scheduler.ramkumar.app/api/slack/callback
# Bot Scopes: incoming-webhook, chat:write
# -----------------------------------------------------------------------------
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_CALLBACK_URL=https://scheduler.ramkumar.app/api/slack/callback

# -----------------------------------------------------------------------------
# Background Worker Performance Tuning
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=200
EMBEDDED_WORKER=false
