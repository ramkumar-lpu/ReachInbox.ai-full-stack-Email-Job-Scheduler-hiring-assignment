# =============================================================================
# ReachInbox Scheduler - Backend Environment Configuration Example
# Copy this file to .env before starting the backend application:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# =============================================================================

# Server Environment
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# If running Docker Compose with default ports: port 5432
# If running with Windows port-conflict override (root .env POSTGRES_PORT=5433): port 5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/reachinbox_scheduler

# Redis Connection (BullMQ / Queue / Cache)
# If running with Windows port-conflict override (root .env REDIS_PORT=6380): port 6380
REDIS_URL=redis://localhost:6380

# Elasticsearch Connection (Search & Indexing)
# Format: http://<host>:<port>
# NOTE: Security is disabled only for local single-node development.
ELASTICSEARCH_URL=http://localhost:9200

# Optional Host Port Overrides for Docker Compose (configured in root .env)
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# ELASTICSEARCH_PORT=9200
